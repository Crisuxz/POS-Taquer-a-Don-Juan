{
  "name": "pos-taqueria-don-juan",
  "version": "0.0.0",
  "private": true,
  "description": "Punto de venta para Taquería Don Juan (monorepo)",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @pos/shared && npm run prisma:generate -w @pos/api",
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate:deploy -w @pos/api",
    "db:migrate:test": "npm run prisma:migrate:deploy:test -w @pos/api",
    "dev:api": "npm run dev -w @pos/api",
    "dev:web": "npm run dev -w @pos/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @pos/api",
    "test:e2e": "npm run test:e2e -w @pos/web",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  }
}
