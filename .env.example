# Variables para docker-compose.yml (opcional: todas tienen valores por defecto
# de desarrollo). Copiar a .env y ajustar. Nunca versionar el archivo .env.

POSTGRES_USER=pos
POSTGRES_PASSWORD=pos_dev_password
POSTGRES_DB=pos_taqueria
POSTGRES_TEST_DB=pos_taqueria_test
POSTGRES_PORT=5432

# Solo para el perfil "full" (API + Web en contenedores)
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001/api
