# Copiar a apps/web/.env.local (o ejecutar `npm run setup:env` en la raíz).
# Las variables NEXT_PUBLIC_* se incrustan en el bundle al compilar
# (`next build`): son públicas, nunca deben contener secretos.

# URL base de la API REST (incluye el prefijo /api)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
