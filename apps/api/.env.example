# Copiar a apps/api/.env (o ejecutar `npm run setup:env` en la raíz).
# Nunca versionar el archivo .env.

NODE_ENV=development
PORT=3001

# PostgreSQL de docker-compose.yml (valores de desarrollo local)
DATABASE_URL=postgresql://pos:pos_dev_password@localhost:5432/pos_taqueria
# Base exclusiva para pruebas de integración (se crea automáticamente en Docker)
DATABASE_URL_TEST=postgresql://pos:pos_dev_password@localhost:5432/pos_taqueria_test

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:3000

# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
